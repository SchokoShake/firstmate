+# This run's Claude Code store is deliberately logged out, so every turn ends
+# in an API failure: Claude Code fires the worker's gated StopFailure hook
+# (event=stop-failure in the busy record) instead of Stop. A turn has ended
+# when Stop touched turn-ended, or when the busy record moved past the line
+# seen before the last steer to a stop or stop-failure event.
+TURN_MARK=
+busy_line() { cat "$HOME_DIR/state/$ID.busy-state" 2>/dev/null; }
+turn_ended() {
+  [ -e "$HOME_DIR/state/$ID.turn-ended" ] && return 0
+  local l; l=$(busy_line)
+  [ "$l" != "$TURN_MARK" ] || return 1
+  case "$l" in *" source=claude-hook event=stop "*|*" source=claude-hook event=stop-failure "*) return 0 ;; esac
+  return 1
+}
